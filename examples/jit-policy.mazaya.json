{
  "schema_version": 1,
  "project": "mazaya",
  "repository": "mufarri7/mazaya_backend",
  "workflow_path": ".github/workflows/trusted-self-hosted-data-plane.yml",
  "workflow_name": "Trusted Self-Hosted Data Plane",
  "admission_job_name": "Admit exact candidate from trusted main",
  "trusted_branch": "main",
  "allowed_actors": [
    "mufarri7"
  ],
  "label_prefix": "mazaya-admission-",
  "runner_group_id": 1,
  "max_slots": 2,
  "max_replacements": 4,
  "freshness_seconds": 3600,
  "poll_seconds": 10,
  "max_runtime_seconds": 21600,
  "rootless_docker": true,
  "forbidden_online_labels": [
    "self-hosted",
    "linux",
    "x64",
    "arm64",
    "shared-ci",
    "mazaya-ci"
  ],
  "persistent_project": "mazaya"
}
