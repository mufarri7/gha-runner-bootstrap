#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

GHRCTL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/core.sh
source "${GHRCTL_ROOT}/lib/core.sh"
# shellcheck source=lib/state.sh
source "${GHRCTL_ROOT}/lib/state.sh"
# shellcheck source=lib/host.sh
source "${GHRCTL_ROOT}/lib/host.sh"
# shellcheck source=lib/scanner.sh
source "${GHRCTL_ROOT}/lib/scanner.sh"
# shellcheck source=lib/project.sh
source "${GHRCTL_ROOT}/lib/project.sh"
# shellcheck source=lib/runner.sh
source "${GHRCTL_ROOT}/lib/runner.sh"
# shellcheck source=lib/jit_admission.sh
source "${GHRCTL_ROOT}/lib/jit_admission.sh"
# shellcheck source=lib/jit_evidence.sh
source "${GHRCTL_ROOT}/lib/jit_evidence.sh"
# shellcheck source=lib/jit_worker.sh
source "${GHRCTL_ROOT}/lib/jit_worker.sh"
# shellcheck source=lib/jit_migration.sh
source "${GHRCTL_ROOT}/lib/jit_migration.sh"
