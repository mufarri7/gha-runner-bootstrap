source "${GHRCTL_ROOT}/lib/operations.sh"
# shellcheck source=lib/backup.sh
source "${GHRCTL_ROOT}/lib/backup.sh"
# shellcheck source=lib/cli.sh
source "${GHRCTL_ROOT}/lib/cli.sh"

main() {
  parse_global_options "$@"
  set -- "${REMAINING_ARGS[@]}"
  dispatch_command "${1:-interactive}" "${@:2}"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
